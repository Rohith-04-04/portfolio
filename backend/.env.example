# ==============================================================================
# Environment Configuration Template (Placeholders Only - Never commit secrets)
# ==============================================================================

# Server Port (Render / Cloud platforms provide PORT automatically)
PORT=8080

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/portfolio_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Email Notification Configuration (Spring Mail)
# For Gmail: Use an App Password generated at https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_gmail_address@gmail.com
SPRING_MAIL_PASSWORD=your_16_character_app_password

# Custom Portfolio Settings
PORTFOLIO_MAIL_RECIPIENT=rohitheli4444@gmail.com
PORTFOLIO_CORS_ALLOWED_ORIGINS=http://localhost:5500,https://rohith-04-04.github.io
